22.6, "end": 326.28000000000003, "text": " The velocity time graph is therefore piecewise constant", "tokens": [50364, 440, 9269, 565, 4295, 307, 4412, 2522, 3711, 5754, 50548], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compression_ratio": 1.7692307692307692, "no_speech_prob": 0.0033951979130506516}, {"id": 65, "seek": 32260, "start": 326.28000000000003, "end": 330.92, "text": " with horizontal segments at positive 1.0 meters per second,", "tokens": [50548, 365, 12750, 19904, 412, 3353, 502, 13, 15, 8146, 680, 1150, 11, 50780], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compression_ratio": 1.7692307692307692, "no_speech_prob": 0.0033951979130506516}, {"id": 66, "seek": 32260, "start": 330.92, "end": 336.12, "text": " 0.0 meters per second, and negative 0.5 meters per second", "tokens": [50780, 1958, 13, 15, 8146, 680, 1150, 11, 293, 3671, 1958, 13, 20, 8146, 680, 1150, 51040], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compression_ratio": 1.7692307692307692, "no_speech_prob": 0.0033951979130506516}, {"id": 67, "seek": 32260, "start": 336.12, "end": 338.92, "text": " over the three corresponding intervals.", "tokens": [51040, 670, 264, 1045, 11760, 26651, 13, 51180], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compression_ratio": 1.7692307692307692, "no_speech_prob": 0.0033951979130506516}, {"id": 68, "seek": 32260, "start": 338.92, "end": 340.28000000000003, "text": " The conclusion.", "tokens": [51180, 440, 10063, 13, 51248], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compression_ratio": 1.7692307692307692, "no_speech_prob": 0.0033951979130506516}, {"id": 69, "seek": 32260, "start": 340.28000000000003, "end": 346.84000000000003, "text": " The velocity is positive 1.0 meters per second from 0 to 0.5 seconds,", "tokens": [51248, 440, 9269, 307, 3353, 502, 13, 15, 8146, 680, 1150, 490, 1958, 281, 1958, 13, 20, 3949, 11, 51576], "temperature": 0.0, "avg_logprob": -0.07850508875661082, "compressi