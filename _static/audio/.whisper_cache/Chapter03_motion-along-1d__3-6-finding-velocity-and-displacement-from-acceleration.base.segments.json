-0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 49, "seek": 21600, "start": 227.0, "end": 229.0, "text": " Part C.", "tokens": [50914, 4100, 383, 13, 51014], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 50, "seek": 21600, "start": 229.0, "end": 232.0, "text": " What is the position function of the motorboat?", "tokens": [51014, 708, 307, 264, 2535, 2445, 295, 264, 5932, 31883, 30, 51164], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 51, "seek": 21600, "start": 232.0, "end": 233.0, "text": " Part D.", "tokens": [51164, 4100, 413, 13, 51214], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 52, "seek": 21600, "start": 233.0, "end": 240.0, "text": " What is the displacement of the motorboat from the time it begins to decelerate to the time its velocity reaches 0?", "tokens": [51214, 708, 307, 264, 21899, 295, 264, 5932, 31883, 490, 264, 565, 309, 7338, 281, 979, 6185, 473, 281, 264, 565, 1080, 9269, 14235, 1958, 30, 51564], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 53, "seek": 21600, "start": 240.0, "end": 242.0, "text": " Part E.", "tokens": [51564, 4100, 462, 13, 51664], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 54, "seek": 21600, "start": 242.0, "end": 245.0, "text": " Graph the velocity and position functions.", "tokens": [51664, 21884, 264, 9269, 293, 2535, 6828, 13, 51814], "temperature": 0.0, "avg_logprob": -0.06531908560772332, "compression_ratio": 2.0875, "no_speech_prob": 0.03481520339846611}, {"id": 55, "seek": 24500, "start": 245.0, "end": 246.0, "text": " The model.", "tokens": [50364, 440, 2316, 13, 50414], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 56, "seek": 24500, "start": 246.0, "end": 251.0, "text": " The motorboat moves in one dimension along the direction of its initial motion.", "tokens": [50414, 440, 5932, 31883, 6067, 294, 472, 10139, 2051, 264, 3513, 295, 1080, 5883, 5394, 13, 50664], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 57, "seek": 24500, "start": 251.0, "end": 255.0, "text": " The acceleration is time-dependent and points opposite the motion,", "tokens": [50664, 440, 17162, 307, 565, 12, 36763, 317, 293, 2793, 6182, 264, 5394, 11, 50864], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 58, "seek": 24500, "start": 255.0, "end": 259.0, "text": " so velocity is found by integrating acceleration,", "tokens": [50864, 370, 9269, 307, 1352, 538, 26889, 17162, 11, 51064], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 59, "seek": 24500, "start": 259.0, "end": 262.0, "text": " and position is found by integrating velocity.", "tokens": [51064, 293, 2535, 307, 1352, 538, 26889, 9269, 13, 51214], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 60, "seek": 24500, "start": 262.0, "end": 269.0, "text": " We choose the initial position as the origin and measure time from the instant the deceleration begins.", "tokens": [51214, 492, 2826, 264, 5883, 2535, 382, 264, 4957, 293, 3481, 565, 490, 264, 9836, 264, 979, 16096, 7338, 13, 51564], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 61, "seek": 24500, "start": 269.0, "end": 270.0, "text": " The math.", "tokens": [51564, 440, 5221, 13, 51614], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 62, "seek": 24500, "start": 270.0, "end": 271.0, "text": " Part A.", "tokens": [51614, 4100, 316, 13, 51664], "temperature": 0.0, "avg_logprob": -0.05564680629306369, "compression_ratio": 1.825242718446602, "no_speech_prob": 0.0017925825668498874}, {"id": 63, "seek": 27100, "start": 271.0, "end": 277.0, "text": " Velocity is found by integrating the acceleration function with respect to time,", "tokens": [50364, 17814, 905, 507, 307, 1352, 538, 26889, 264, 17162, 2445, 365, 3104, 281, 565, 11, 50664], "temperature": 0.0, "avg_logprob": -0.09283015602513363, "compression_ratio": 1.801980198019802, "no_speech_prob": 0.14718744158744812}, {"id": 64, "seek": 27100, "start": 277.0, "end": 282.0, "text": " which gives V of T equals the integral of A of T with respect to T,", "tokens": [50664, 597, 2709, 691, 295, 314, 6915, 264, 11573, 295, 316, 295, 314, 365, 3104, 281, 314, 11, 50914], "temperature": 0.0, "avg_logprob": -0.09283015602513363, "compression_ratio": 1.801980198019802, "no_speech_prob": 0.14718744158744812}, {"id": 65, "seek": 27100, "start": 282.0, "end": 287.0, "text": " which equals the integral of negative 1-4th T with respect to T,", "tokens": [50914, 597, 6915, 264, 11573, 295, 3671, 502, 12, 19, 392, 314, 365, 3104, 281, 314, 11, 51164], "temperature": 0.0, "avg_logprob": -0.09283015602513363, "compression_ratio": 1.801980198019802, "no_speech_prob": 0.14718744158744812}, {"id": 66, "seek": 27100, "start": 287.0, "end": 292.0, "text": " and equals negative 1-8th T squared plus C sub 1.", "tokens": [51164, 293, 6915, 3671, 502, 12, 23, 392, 314, 8889, 1804, 383, 1422, 502, 13, 51414], "temperature": 0.0, "avg_logprob": -0.09283015602513363, "compression_ratio": 1.801980198019802, "no_speech_prob": 0.14718744158744812}, {"id": 67, "seek": 27100, "start": 292.0, "end": 300.0, "text": " The integration constant is determined by the initial velocity, V of 0 equals 5.0 meters per second,", "tokens": [51414, 440, 10980, 5754, 307, 9540, 538, 264, 5883, 9269, 11, 691, 295, 1958, 6915, 1025, 13, 15, 8146, 680, 1150, 11, 51814], "temperature": 0.0, "avg_logprob": -0.09283015602513363, "compression_ratio": 1.801980198019802, "no_speech_prob": 0.14718744158744812}, {"id": 68, "seek": 30000, "start": 300.0, "end": 305.0, "text": " which gives C sub 1 equals 5.0 meters per second.", "tokens": [50364, 597, 2709, 383, 1422, 502, 6915, 1025, 13, 15, 8146, 680, 1150, 13, 50614], "temperature": 0.0, "avg_logprob": -0.042685744166374204, "compression_ratio": 1.740506329113924, "no_speech_prob": 0.002723354147747159}, {"id": 69, "seek": 30000, "start": 305.0, "end": 314.0, "text": " The velocity function is therefore V of T equals 5.0 minus 1-8th T squared in meters per second.", "tokens": [50614, 440, 9269, 2445, 307, 4412, 691, 295, 314, 6915, 1025, 13, 15, 3175, 502, 12, 23, 392, 314, 8889, 294, 8146, 680, 1150, 13, 51064], "temperature": 0.0, "avg_logprob": -0.042685744166374204, "compression_ratio": 1.740506329113924, "no_speech_prob": 0.002723354147747159}, {"id": 70, "seek": 30000, "start": 314.0, "end": 315.0, "text": " Part B.", "tokens": [51064, 4100, 363, 13, 51114], "temperature": 0.0, "avg_logprob": -0.042685744166374204, "compression_ratio": 1.740506329113924, "no_speech_prob": 0.002723354147747159}, {"id": 71, "seek": 30000, "start": 315.0, "end": 318.0, "text": " The stopping time occurs when the velocity reaches 0,", "tokens": [51114, 440, 12767, 565, 11843, 562, 264, 9269, 14235, 1958, 11, 51264], "temperature": 0.0, "avg_logprob": -0.042685744166374204, "compression_ratio": 1.740506329113924, "no_speech_prob": 0.002723354147747159}, {"id": 72, "seek": 30000, "start": 318.0, "end": 325.0, "text": " so the velocity function gives 0 equals 5.0 minus 1-8th T squared.", "tokens": [51264, 370, 264, 9269, 2445, 2709, 1958, 6915, 1025, 13, 15, 3175, 502, 12, 23, 392, 314, 8889, 13, 51614], "temperature": 0.0, "avg_logprob": -0.042685744166374204, "compression_ratio": 1.740506329113924, "no_speech_prob": 0.002723354147747159}, {"id": 73, "seek": 32500, "start": 325.0, "end": 330.0, "text": " Solving this equation for the positive time gives T squared equals 40.", "tokens": [50364, 7026, 798, 341, 5367, 337, 264, 3353, 565, 2709, 314, 8889, 6915, 3356, 13, 50614], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 74, "seek": 32500, "start": 330.0, "end": 333.0, "text": " T equals 6.3 seconds.", "tokens": [50614, 314, 6915, 1386, 13, 18, 3949, 13, 50764], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 75, "seek": 32500, "start": 333.0, "end": 335.0, "text": " Part C.", "tokens": [50764, 4100, 383, 13, 50864], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 76, "seek": 32500, "start": 335.0, "end": 339.0, "text": " Position is found by integrating the velocity function with respect to time,", "tokens": [50864, 29780, 307, 1352, 538, 26889, 264, 9269, 2445, 365, 3104, 281, 565, 11, 51064], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 77, "seek": 32500, "start": 339.0, "end": 345.0, "text": " which gives X of T equals the integral of V of T with respect to T,", "tokens": [51064, 597, 2709, 1783, 295, 314, 6915, 264, 11573, 295, 691, 295, 314, 365, 3104, 281, 314, 11, 51364], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 78, "seek": 32500, "start": 345.0, "end": 352.0, "text": " which equals the integral of 5.0 minus 1-8th T squared with respect to T,", "tokens": [51364, 597, 6915, 264, 11573, 295, 1025, 13, 15, 3175, 502, 12, 23, 392, 314, 8889, 365, 3104, 281, 314, 11, 51714], "temperature": 0.0, "avg_logprob": -0.02612315524708141, "compression_ratio": 1.7624309392265194, "no_speech_prob": 0.07664074748754501}, {"id": 79, "seek": 35200, "start": 352.0, "end": 359.0, "text": " and equals 5.0T minus 1-24th T cubed plus C sub 2.", "tokens": [50364, 293, 6915, 1025, 13, 15, 51, 3175, 502, 12, 7911, 392, 314, 36510, 1804, 383, 1422, 568, 13, 50714], "temperature": 0.0, "avg_logprob": -0.0386491574739155, "compression_ratio": 1.6466165413533835, "no_speech_prob": 0.019168969243764877}, {"id": 80, "seek": 35200, "start": 359.0, "end": 364.0, "text": " The initial position is chosen to be X of 0 equals 0,", "tokens": [50714, 440, 5883, 2535, 307, 8614, 281, 312, 1783, 295, 1958, 6915, 1958, 11, 50964], "temperature": 0.0, "avg_logprob": -0.0386491574739155, "compression_ratio": 1.6466165413533835, "no_speech_prob": 0.019168969243764877}, {"id": 81, "seek": 35200, "start": 364.0, "end": 367.0, "text": " so C sub 2 equals 0.", "tokens": [50964, 370, 383, 1422, 568, 6915, 1958, 13, 51114], "temperature": 0.0, "avg_logprob": -0.0386491574739155, "compression_ratio": 1.6466165413533835, "no_speech_prob": 0.019168969243764877}, {"id": 82, "seek": 35200, "start": 367.0, "end": 377.0, "text": " The position function is therefore X of T equals 5.0T minus 1-24th T cubed in meters.", "tokens": [51114, 440, 2535, 2445, 307, 4412, 1783, 295, 314, 6915, 1025, 13, 15, 51, 3175, 502, 12, 7911, 392, 314, 36510, 294, 8146, 13, 51614], "temperature": 0.0, "avg_logprob": -0.0386491574739155, "compression_ratio": 1.6466165413533835, "no_speech_prob": 0.019168969243764877}, {"id": 83, "seek": 35200, "start": 377.0, "end": 378.0, "text": " Part D.", "tokens": [51614, 4100, 413, 13, 51664], "temperature": 0.0, "avg_logprob": -0.0386491574739155, "compression_ratio": 1.6466165413533835, "no_speech_prob": 0.019168969243764877}, {"id": 84, "seek": 37800, "start": 378.0, "end": 384.0, "text": " The displacement while the boat slows to rest is found by evaluating the position function", "tokens": [50364, 440, 21899, 1339, 264, 6582, 35789, 281, 1472, 307, 1352, 538, 27479, 264, 2535, 2445, 50664], "temperature": 0.0, "avg_logprob": -0.05409507510028308, "compression_ratio": 1.52020202020202, "no_speech_prob": 0.017702210694551468}, {"id": 85, "seek": 37800, "start": 384.0, "end": 399.0, "text": " at T equals 6.3 seconds, which gives X of 6.3 seconds equals 5.0 times 6.3 minus 1-24th times 6.3 cubed equals 21 meters.", "tokens": [50664, 412, 314, 6915, 1386, 13, 18, 3949, 11, 597, 2709, 1783, 295, 1386, 13, 18, 3949, 6915, 1025, 13, 15, 1413, 1386, 13, 18, 3175, 502, 12, 7911, 392, 1413, 1386, 13, 18, 36510, 6915, 5080, 8146, 13, 51414], "temperature": 0.0, "avg_logprob": -0.05409507510028308, "compression_ratio": 1.52020202020202, "no_speech_prob": 0.017702210694551468}, {"id": 86, "seek": 37800, "start": 399.0, "end": 401.0, "text": " Part E.", "tokens": [51414, 4100, 462, 13, 51514], "temperature": 0.0, "avg_logprob": -0.05409507510028308, "compression_ratio": 1.52020202020202, "no_speech_prob": 0.017702210694551468}, {"id": 87, "seek": 37800, "start": 401.0, "end": 406.0, "text": " The velocity and position graphs are generated from the functions derived above.", "tokens": [51514, 440, 9269, 293, 2535, 24877, 366, 10833, 490, 264, 6828, 18949, 3673, 13, 51764], "temperature": 0.0, "avg_logprob": -0.05409507510028308, "compression_ratio": 1.52020202020202, "no_speech_prob": 0.017702210694551468}, {"id": 88, "seek": 40600, "start": 406.0, "end": 411.0, "text": " The velocity graph decreases to 0 at T equals 6.3 seconds,", "tokens": [50364, 440, 9269, 4295, 24108, 281, 1958, 412, 314, 6915, 1386, 13, 18, 3949, 11, 50614], "temperature": 0.0, "avg_logprob": -0.06332487048524799, "compression_ratio": 1.437125748502994, "no_speech_prob": 0.016675807535648346}, {"id": 89, "seek": 40600, "start": 411.0, "end": 416.0, "text": " and the position graph reaches its maximum value at that same time.", "tokens": [50614, 293, 264, 2535, 4295, 14235, 1080, 6674, 2158, 412, 300, 912, 565, 13, 50864], "temperature": 0.0, "avg_logprob": -0.06332487048524799, "compression_ratio": 1.437125748502994, "no_speech_prob": 0.016675807535648346}, {"id": 90, "seek": 40600, "start": 416.0, "end": 418.0, "text": " The conclusion.", "tokens": [50864, 440, 10063, 13, 50964], "temperature": 0.0, "avg_logprob": -0.06332487048524799, "compression_ratio": 1.437125748502994, "no_speech_prob": 0.016675807535648346}, {"id": 91, "seek": 40600, "start": 418.0, "end": 427.0, "text": " The motorboats velocity function is V of T equals 5.0 minus 1-8th T squared in meters per second,", "tokens": [50964, 440, 5932, 1763, 1720, 9269, 2445, 307, 691, 295, 314, 6915, 1025, 13, 15, 3175, 502, 12, 23, 392, 314, 8889, 294, 8146, 680, 1150, 11, 51414], "temperature": 0.0, "avg_logprob": -0.06332487048524799, "compression_ratio": 1.437125748502994, "no_speech_prob": 0.016675807535648346}, {"id": 92, "seek": 42700, "start": 427.0, "end": 436.0, "text": " and its position function is X of T equals 5.0T minus 1-24th T cubed in meters.", "tokens": [50364, 293, 1080, 2535, 2445, 307, 1783, 295, 314, 6915, 1025, 13, 15, 51, 3175, 502, 12, 7911, 392, 314, 36510, 294, 8146, 13, 50814], "temperature": 0.0, "avg_logprob": -0.0504131093621254, "compression_ratio": 1.54375, "no_speech_prob": 0.03029036521911621}, {"id": 93, "seek": 42700, "start": 436.0, "end": 443.0, "text": " The velocity reaches 0 at 6.3 seconds after the boat has traveled 21 meters.", "tokens": [50814, 440, 9269, 14235, 1958, 412, 1386, 13, 18, 3949, 934, 264, 6582, 575, 16147, 5080, 8146, 13, 51164], "temperature": 0.0, "avg_logprob": -0.0504131093621254, "compression_ratio": 1.54375, "no_speech_prob": 0.03029036521911621}, {"id": 94, "seek": 42700, "start": 443.0, "end": 449.0, "text": " The velocity graph crosses 0 at the same time that the position graph reaches its maximum.", "tokens": [51164, 440, 9269, 4295, 28467, 1958, 412, 264, 912, 565, 300, 264, 2535, 4295, 14235, 1080, 6674, 13, 51464], "temperature": 0.0, "avg_logprob": -0.0504131093621254, "compression_ratio": 1.54375, "no_speech_prob": 0.03029036521911621}], "language": "en"}